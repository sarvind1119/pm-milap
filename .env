# ── PM-MILAP configuration ───────────────────────────────────────────────
# Copy to ".env" (optional). The app runs with these defaults out of the box.

PORT=3000
JWT_SECRET=pm-milap-dev-secret-change-me

# ── Local LLM (OpenAI-compatible) ────────────────────────────────────────
# The app works fully even if this endpoint is unreachable — it falls back to
# deterministic local generators so the demo is always functional.
LLM_ENABLED=true
LLM_API_KEY=sk-class-2026
LLM_BASE_URL=http://10.10.202.212:8000/v1
LLM_MODEL=openai/gpt-oss-20b
# Local 20B+ models can be slow to respond — give them generous time (ms).
LLM_TIMEOUT_MS=60000
# response_format / JSON mode: "auto" sends it and retries without it if the
# server rejects it; set to "off" if your server dislikes response_format.
LLM_JSON_MODE=auto

# How often the background matching engine re-runs (milliseconds)
MATCH_INTERVAL_MS=120000
